{
  "name": "jazzbb-wp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:watch": "vite build --watch",
    "test:e2e": "playwright test",
    "wp:up": "docker compose up -d",
    "wp:down": "docker compose down",
    "wp:destroy": "docker compose down -v",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "wp:setup": "bash scripts/wp-setup.sh",
    "hook:install": "bash scripts/install-hook.sh",
    "notices": "node scripts/third-party-notices.mjs",
    "demo:screenshot": "node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.6.5",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-heading": "^3.11.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.6.5",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/pm": "^3.6.5",
    "@tiptap/starter-kit": "^3.31.4",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "tiptap-extension-resize-image": "^1.4.7",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.8.4",
    "typescript": "^5.4.5",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "GPL-2.0-or-later"
}
